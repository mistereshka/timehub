{
  "name": "timehub",
  "version": "0.1.0",
  "description": "Tasks, time tracking and an automatic daily activity timeline for Windows — in GitHub style",
  "main": "./out/main/index.js",
  "author": "mistereshka",
  "license": "MIT",
  "homepage": "https://github.com/mistereshka/timehub",
  "repository": "github:mistereshka/timehub",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:win": "npm run build && electron-builder --win --publish never",
    "icons": "electron scripts/render-icons.cjs"
  },
  "dependencies": {
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "@primer/octicons-react": "^19.35.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "date-fns": "^4.4.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "ical.js": "^2.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "koffi@3.2.1": true
  }
}
